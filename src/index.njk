{# ======================================================== #}
{# HERO                                                      #}
{# ======================================================== #}
<section class="hero">
  <div class="wrap hero__inner">

    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Persuasion Literacy &middot; Marketing Psychology &middot; Clear Thinking</p>
      <h1 class="hero__headline">
        <span class="hero__line">A Field Guide</span>
        <span class="hero__line">for Seeing</span>
        <span class="hero__line hero__line--italic"><em><span class="hero__drawn">Clearly.</span></em></span>
      </h1>
      <p class="hero__lede">Brooke Reports helps curious, ambitious people notice the pressure, framing, hype, and emotional signals shaping their decisions; so they can slow down, read the room, and think clearly before someone else quietly takes the wheel.</p>
      <p class="hero__small-line">Cozy detective agency energy, minus the murders. Investigating confusing sales pages, attention traps, internet hype, and suspiciously shiny promises.</p>
      <div class="hero__ctas">
        <a href="/blog/" class="btn btn-primary">Start Reading <span aria-hidden="true">&rarr;</span></a>
        <a href="/second-look/" class="btn btn-ghost">Try Second Look</a>
      </div>
    </div>

    {#
      IMAGE: hero-collage
