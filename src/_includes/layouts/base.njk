<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if overrideTitle %}{{ overrideTitle }}{% elif title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:title" content="{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if tags and 'post' in tags %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ image or site.author.image }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ image or site.author.image }}">

  <link rel="alternate" type="application/atom+xml" title="Brooke Reports" href="/feed.xml">

  {% include "schema.njk" %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a href="/" class="site-logo" aria-label="Brooke Reports — home">Brooke Reports</a>

      <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="main-nav" aria-label="Main">
        <ul>
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a></li>
          <li><a href="/blog/" {% if "/blog" in page.url %}aria-current="page"{% endif %}>Reports</a></li>
          <li><a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a></li>
          <li><a href="/second-look/" {% if page.url == "/second-look/" %}aria-current="page"{% endif %}>Second Look</a></li>
          <li><a href="/contact/" {% if page.url == "/contact/" %}aria-current="page"{% endif %}>Contact</a></li>
        </ul>
      </nav>

      <a href="/#newsletter" class="btn btn-primary site-header__subscribe">Subscribe</a>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__top">

      <div class="site-footer__brand">
        <a href="/" class="site-logo">Brooke Reports</a>
        <p>A field guide<br>for seeing clearly.</p>
      </div>

      <nav class="site-footer__nav" aria-label="Explore">
        <p class="site-footer__nav-heading">Explore</p>
        <ul>
          <li><a href="/blog/">Reports</a></li>
          <li><a href="/second-look/">Second Look</a></li>
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label="Company">
        <p class="site-footer__nav-heading">Company</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label="Connect">
        <p class="site-footer__nav-heading">Connect</p>
        <ul>
          <li><a href="https://www.instagram.com/brookereports" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="https://www.linkedin.com/in/brookecurnow/" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </nav>

      <div class="site-footer__newsletter" id="newsletter">
        <p class="site-footer__newsletter-heading">Get the field notes</p>
        <p class="site-footer__newsletter-sub">A quiet dispatch on persuasion, attention, human behavior, and the clues hiding in plain sight.</p>
        <div class="beehiiv-embed">
          <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="86d44aca-ff2a-4c07-8ebb-da3774307464"></script>
        </div>
      </div>

    </div>

    <div class="site-footer__bottom">
      <div class="wrap site-footer__bottom-inner">
        <p>&copy; {{ "" | currentYear }} Brooke Reports. All rights reserved.</p>
        <nav aria-label="Legal">
          <ul>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms &amp; Conditions</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const nav = document.getElementById('main-nav');
    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        nav.classList.toggle('is-open');
      });
    }
  </script>
</body>
</html>
