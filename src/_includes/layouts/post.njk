---
layout: layouts/base.njk
extraCss: /assets/css/post-page.css
---
<div class="pt-page">

  {# ── POST HEADER ── #}
  <section class="post-header">
    <div class="container">
      <a href="/all-reports/" class="post-header__back">← All Reports</a>

      <p class="post-header__eyebrow">{{ category if category else "Report" }}</p>

      <h1 class="post-header__title">{{ title }}</h1>

      <div class="post-header__meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% if readTime %}
          <span class="post-header__meta-sep">·</span>
          <span>{{ readTime }} min read</span>
        {% endif %}
      </div>
    </div>
  </section>

  {# ── POST HERO IMAGE (from `image` front matter) ── #}
  {% if image %}
  <div class="container">
    <div class="post-hero-image">
      {% image image, imageAlt or "", {
        sizes: "(min-width: 1240px) 1200px, 100vw",
        widths: [600, 900, 1200]
      } %}
    </div>
  </div>
  {% endif %}

  {# ── ARTICLE BODY + AUTHOR BIO ── #}
  <section class="post-body">
    <div class="post-body__inner">
      <article class="post">
        {{ content | safe }}
      </article>
      {% include "author-bio.njk" %}
    </div>
  </section>

  {# ── POST FOOTER ── #}
  <section class="post-footer">
    <div class="post-footer__inner">
      {% if tags %}
      <div class="post-footer__tags">
        {% for tag in tags %}
          {% if tag !== "post" %}
          <a href="/tags/{{ tag | slug }}/" class="post-footer__tag">{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      <a href="/all-reports/" class="post-footer__back">← Back to all reports</a>
    </div>
  </section>

  {# ── MORE POSTS ── #}
  {% set morePosts = collections.posts | except(page.url) | limit(3) %}
  {% if morePosts.length > 0 %}
  <section class="more-posts">
    <div class="container">
      <p class="more-posts__label">More Reports</p>
      <div class="more-posts__grid">
        {% for post in morePosts %}
        <a href="{{ post.url }}" class="more-post-item">
          {% if post.data.category %}
          <span class="more-post-item__cat">{{ post.data.category }}</span>
          {% endif %}
          <p class="more-post-item__title">{{ post.data.title }}</p>
          <time class="more-post-item__date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ── NEWSLETTER STRIP ── #}
  <section class="post-newsletter">
    <div class="container">
      <div class="post-newsletter__inner">
        <div>
          <p class="post-newsletter__headline">Stay <em>informed</em>,<br>not overwhelmed.</p>
          <p class="post-newsletter__sub">New reports and notes, straight to your inbox. No noise.</p>
        </div>
        <div class="beehiiv-embed">
          <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="86d44aca-ff2a-4c07-8ebb-da3774307464"></script>
        </div>
      </div>
    </div>
  </section>

</div>

<script>
  const article = document.querySelector('.post-body__inner article');
  if (article) {
    article.querySelectorAll('p, h2, h3, blockquote, img, ul, ol, hr').forEach(el => {
      el.classList.add('reveal');
    });
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    let delay = 0;
    document.querySelectorAll('.reveal').forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight) {
        setTimeout(() => el.classList.add('visible'), delay);
        delay += 80;
      } else {
        observer.observe(el);
      }
    });
  } else {
    document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
  }
</script>
