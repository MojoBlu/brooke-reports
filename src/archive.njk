---
layout: layouts/base.njk
title: Archive
description: All Brooke Reports posts in one place — persuasion literacy, marketing psychology, behavioral science, and clearer thinking.
permalink: /archive/
schemaType: CollectionPage
---
<h1>Archive</h1>
<ul class="post-list">
  {% for post in collections.posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
  </li>
  {% endfor %}
</ul>
