---
layout: layouts/base.njk
extraCss: /assets/css/blog-page.css
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - tagList
    - postFeed
    - post
    - posts
permalink: /tags/{{ tag | slug }}/
---

<div class="bl-page">

  <!-- HEADER -->
  <header class="blog-header" aria-label="Tag header">
    <div class="container" style="position:relative">
      <span class="blog-header__bg-text" aria-hidden="true">TAG</span>
      <p class="blog-header__eyebrow">Brooke Reports</p>
      <h1 class="blog-header__title">
        Tagged<br>
        <em>{{ tag }}</em>
      </h1>
    </div>
  </header>

  <!-- POST LIST -->
  <section class="post-list" aria-labelledby="posts-label">
    <div class="container">
      <p class="bl-label" id="posts-label" style="margin-bottom:1.5rem">All posts</p>
      {% set taggedPosts = collections[tag] | reverse %}
      {% if taggedPosts.length > 0 %}
      <div class="post-list__grid" id="post-grid">
        {% for post in taggedPosts %}
        {% set isBig = (loop.index0 % 3 == 0) %}
        <a href="{{ post.url }}"
           class="post-item{% if isBig %} post-item--big{% endif %}">
          <div>
            <div class="post-item__meta">
              {% if post.data.category %}
              <span class="post-item__cat">{{ post.data.category }}</span>
              {% endif %}
              <time class="post-item__date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            </div>
            <h3 class="post-item__title">{{ post.data.title }}</h3>
            {% if isBig and post.data.description %}
            <p class="post-item__excerpt">{{ post.data.description }}</p>
            {% endif %}
            {% if isBig %}
            <span class="post-item__arrow" aria-hidden="true">→</span>
            {% endif %}
          </div>
          {% if not isBig %}
          <span class="post-item__arrow" aria-hidden="true">→</span>
          {% endif %}
        </a>
        {% endfor %}
      </div>
      {% else %}
      <p class="post-list__empty">Posts coming soon.</p>
      {% endif %}
    </div>
  </section>

</div>
